# Managed by Ansible (roles/caddy). Do not edit by hand.
{
    admin off
    # internal CA only — no ACME, so no :80 redirect listener (avoids clashing
    # with any nginx/other service already using port 80/443 on this host).
    auto_https disable_redirects
    # don't try to add the CA to the server's system trust store (the caddy user
    # isn't a sudoer, and clients trust the CA explicitly instead).
    skip_install_trust
}

# Job API over HTTPS with Caddy's internal CA. Clients trust the CA once
# (or accept the browser warning). The API still binds 127.0.0.1:8000 locally.
{{ caddy_api_host }}:{{ caddy_https_port }} {
{% if caddy_bind %}
    bind {{ caddy_bind }}
{% endif %}
    tls internal
    encode gzip
    reverse_proxy {{ caddy_api_upstream }}
}
{% if caddy_web_root %}

# Web UI (browser): serves the built SPA and proxies /api/* to the Job API on the
# same origin, so session cookies work and there's no CORS. handle_path strips
# the /api prefix (the API routes live at root, e.g. /jobs).
{{ caddy_web_host }}:{{ caddy_https_port }} {
{% if caddy_bind %}
    bind {{ caddy_bind }}
{% endif %}
    tls internal
    encode gzip
    handle_path /api/* {
        reverse_proxy {{ caddy_api_upstream }}
    }
    handle {
        root * {{ caddy_web_root }}
        try_files {path} /index.html
        file_server
    }
}
{% endif %}
